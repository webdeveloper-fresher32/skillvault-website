{
  "version": 2,
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "MODEL_CACHE_DIR": "/tmp/models",
    "HF_HOME": "/tmp/huggingface",
    "XDG_CACHE_HOME": "/tmp"
  }
}
