# ==============================================================================
# SkillVault Production AI Microservice Configuration (Cloud Deployment)
# ==============================================================================

# 1. Production PostgreSQL Database (e.g. Neon, AWS RDS with pgvector)
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-cold-bread-b4mv005l-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Production Cloud LLM Provider (Groq / Grok xAI / OpenAI)
# Set your preferred high-speed cloud endpoint and API key:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_groq_api_key_here
CHAT_MODEL=qwen/qwen3.8-27b

# (Alternative: Grok / xAI)
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=xai-your_xai_key_here
# CHAT_MODEL=grok-2-mini

# (Alternative: OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-proj-your_openai_key_here
# CHAT_MODEL=gpt-4o-mini

# 3. Production Embeddings Configuration (In-Process CPU, zero-cost, 768 dim)
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=nomic-embed-text

# 4. Multi-Tenant Default Organization ID
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# 5. In-Process FlashRank Cross-Encoder Cache Directory (CPU)
MODEL_CACHE_DIR=/tmp/models
